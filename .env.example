# ---- Core ----
APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# ---- Database ----
# SQLite (default, zero setup). Swap for Postgres in production:
# DATABASE_URL=postgresql+psycopg://user:pass@host:25060/loopdesk?sslmode=require
DATABASE_URL=sqlite:///./data/loopdesk.db

# ---- Model provider ----
# mock | gemma | openai_compat
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Confirm the id your key can actually call:
#   python -m backend.agent.check_provider --list
GEMINI_MODEL=gemma-4-31b-it
GEMINI_EMBED_MODEL=gemini-embedding-001

# Any OpenAI-compatible endpoint: Ollama, vLLM, or DigitalOcean's serverless
# inference. Defaults below are Ollama on localhost.
#
# DigitalOcean serverless inference (check availability - it has been in
# preview, and model ids change):
#   OPENAI_COMPAT_BASE_URL=https://inference.do-ai.run/v1
#   OPENAI_COMPAT_API_KEY=<model access key from the DO control panel>
#   OPENAI_COMPAT_MODEL=openai-gpt-oss-120b
# Confirm the exact ids by GETting https://inference.do-ai.run/v1/models
# with that key as a bearer token.
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gemma3:12b
OPENAI_COMPAT_EMBED_MODEL=bge-small

# ---- Storage ----
# local | spaces
STORAGE_BACKEND=local
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=

# ---- GitHub ----
# Leave GITHUB_TOKEN empty to run in dry-run mode (issues are mirrored locally only).
GITHUB_TOKEN=
GITHUB_REPO=your-org/loopdesk-demo-tickets
# Where approved solutions are committed. Defaults to GITHUB_REPO.
GITHUB_SOLUTIONS_REPO=your-org/loopdesk
GITHUB_WEBHOOK_SECRET=dev-secret
# The hand-seeded open ticket used for the duplicate / "Me too" demo.
# Issue numbers start at 1 in a fresh repo, so set this to the real one.
DEMO_DUPLICATE_ISSUE=42

# ---- Agent tuning ----
CONFIDENCE_HIGH=0.7
CONFIDENCE_LOW=0.4
ADMIN_TOKEN=dev-admin
